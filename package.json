{
  "name": "main2",
  "version": "0.0.1",
  "description": "CLI framework 2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*",
    "./error-handler": "./dist/error-handler.js",
    "./paths": "./dist/paths.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run lint:src && tsc --build tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "lint": "eslint --cache \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:src": "eslint --cache \"src/**/*.ts\"",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run lint && vitest",
    "watch": "tsc --watch --project tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "18.15.3",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "5.55.0",
    "@vitest/coverage-c8": "^0.29.3",
    "eslint": "8.36.0",
    "eslint-import-resolver-typescript": "3.5.3",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-tsdoc": "^0.2.17",
    "ts-node": "10.9.1",
    "typescript": "4.9.5",
    "vitest": "^0.29.3"
  },
  "keywords": [],
  "author": "Chris Barber <me@chrisbarber.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=16.13.0"
  },
  "packageManager": "pnpm@7.26.2"
}
