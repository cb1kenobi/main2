{
  "name": "main2",
  "version": "0.0.1",
  "description": "CLI framework 2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*",
    "./error-handler": "./dist/error-handler.js",
    "./paths": "./dist/paths.js",
    "./updates": "./dist/updates.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:bundle && pnpm build:types",
    "build:bundle": "rimraf dist && rollup -c rollup.config.ts --configPlugin typescript",
    "build:types": "pnpm build:types:temp && pnpm build:types:roll && pnpm build:types:check",
    "build:types:temp": "tsc --declaration --emitDeclarationOnly --outDir temp --project tsconfig.build.json",
    "build:types:roll": "rollup --config rollup.dts.config.ts --configPlugin typescript && rimraf temp",
    "build:types:check": "tsc --project tsconfig.check.json",
    "coverage": "vitest --coverage",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test-no-tty": "node -e \"try { console.log(require('child_process').execSync('pnpm coverage').toString()); } catch (e) { console.log(e, e.stdout.toString()); console.log(e.stderr.toString()); }\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.0",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "0.24.0",
    "lefthook": "1.9.3",
    "npm-check-updates": "17.1.13",
    "oxlint": "0.15.3",
    "rimraf": "6.0.1",
    "rollup": "4.28.1",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-esbuild": "6.1.1",
    "tslib": "2.8.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/cb1kenobi/main2",
  "bugs": "https://github.com/cb1kenobi/main2/issues",
  "repository": "https://github.com/cb1kenobi/main2",
  "keywords": [],
  "author": "Chris Barber <me@chrisbarber.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=16.13.0"
  },
  "packageManager": "pnpm@9.15.0"
}
