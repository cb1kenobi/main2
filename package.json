{
  "name": "main2",
  "version": "0.0.1",
  "description": "CLI framework 2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*",
    "./error-handler": "./dist/error-handler.js",
    "./paths": "./dist/paths.js",
    "./updates": "./dist/updates.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run lint:src && tsc --build tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "lint": "pnpm run lint:src && pnpm run lint:test  ",
    "lint:src": "eslint --cache \"src/**/*.ts\"",
    "lint:test": "eslint --cache --config \"test/.eslintrc.cjs\" \"test/**/*.ts\"",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run lint && vitest",
    "watch": "tsc --watch --project tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "@typescript-eslint/eslint-plugin": "6.1.0",
    "@typescript-eslint/parser": "6.1.0",
    "@vitest/coverage-c8": "0.33.0",
    "@vitest/coverage-v8": "^0.33.0",
    "eslint": "8.45.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-tsdoc": "0.2.17",
    "ts-node": "10.9.1",
    "typescript": "5.1.6",
    "vitest": "0.33.0"
  },
  "keywords": [],
  "author": "Chris Barber <me@chrisbarber.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=16.13.0"
  },
  "packageManager": "pnpm@8.6.5"
}
