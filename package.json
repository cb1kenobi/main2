{
  "name": "main2",
  "version": "0.0.1",
  "description": "CLI framework 2",
  "keywords": [],
  "homepage": "https://github.com/cb1kenobi/main2",
  "bugs": {
    "url": "https://github.com/cb1kenobi/main2/issues"
  },
  "license": "MIT",
  "author": "Chris Barber <me@chrisbarber.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb1kenobi/main2.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./error-handler": {
      "types": "./dist/error-handler.d.mts",
      "default": "./dist/error-handler.mjs"
    },
    "./paths": {
      "types": "./dist/paths.d.mts",
      "default": "./dist/paths.mjs"
    },
    "./updates": {
      "types": "./dist/updates.d.mts",
      "default": "./dist/updates.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsdown -c tsdown.config.ts",
    "check": "pnpm type-check && pnpm lint && pnpm fmt:check",
    "coverage": "vitest --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:bun": "bun --bun test --config=bunfig.toml",
    "test:deno": "deno run --allow-all --sloppy-imports ./node_modules/vitest/vitest.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
