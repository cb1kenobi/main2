{
  "name": "main2",
  "version": "0.0.1",
  "description": "CLI framework 2",
  "author": "Chris Barber <me@chrisbarber.dev>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./*",
    "./error-handler": "./dist/error-handler.js",
    "./paths": "./dist/paths.js",
    "./updates": "./dist/updates.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:bundle && pnpm build:types",
    "build:bundle": "rimraf dist && rollup -c rollup.config.ts --configPlugin typescript",
    "build:types": "pnpm build:types:temp && pnpm build:types:roll && pnpm build:types:check",
    "build:types:temp": "tsc --declaration --emitDeclarationOnly --outDir temp --project tsconfig.build.json",
    "build:types:roll": "rollup --config rollup.dts.config.ts --configPlugin typescript && rimraf temp",
    "build:types:check": "tsc --project tsconfig.check.json",
    "check": "pnpm type-check && pnpm lint",
    "coverage": "vitest --coverage",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:bun": "bun --bun test",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.10",
    "lefthook": "1.13.2",
    "oxlint": "1.16.0",
    "rimraf": "6.0.1",
    "rollup": "4.52.0",
    "rollup-plugin-dts": "6.2.3",
    "rollup-plugin-esbuild": "6.2.1",
    "tslib": "2.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "homepage": "https://github.com/cb1kenobi/main2",
  "repository": {
    "type": "git",
    "url": "https://github.com/cb1kenobi/main2.git"
  },
  "bugs": {
    "url": "https://github.com/cb1kenobi/main2/issues"
  },
  "engines": {
    "node": ">=16.13.0"
  }
}
