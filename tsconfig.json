{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "lib": [ "ES2022" ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist",
    "preserveWatchOutput": true,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "target": "ES2022",
    "types": [
      "vitest/globals"
    ]
  },
  "exclude": ["dist", "node_modules"],
  "include": ["./src", "./test"]
}
