{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "lib": [ "ES2022" ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist",
    "preserveWatchOutput": true,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "target": "ES2022",
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "exclude": ["node_modules", "**/*/dist"],
  "include": ["./src", "./test"]
}
